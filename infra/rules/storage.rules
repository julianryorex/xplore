rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Gallery originals live at gallery/{tripId}/{uid}/{imageId}.
    //
    // Trip membership cannot be checked here: Storage rules can only read the
    // (default) Firestore database, and this project's data lives in the named
    // `xplore-app` database, so a firestore.get() on trips/{tripId} always fails
    // and denied every upload. Access is therefore owner-scoped:
    //  - a signed-in user may write only under their own uid segment;
    //  - only the uploader reads through the SDK. Other members fetch the
    //    original via the tokenized download URL stored on the photo's Firestore
    //    doc, and that doc is readable by trip members only (firestore.rules).
    // A non-member can thus park files under their own uid in any trip's prefix,
    // but nothing references them, so no member is ever shown them.
    match /gallery/{tripId}/{uid}/{imageId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();
      // Update covers a retried upload of the same photo. 100 MB bounds what one
      // object can cost.
      allow create, update: if isOwner() && request.resource.size <= 100 * 1024 * 1024;
      // The uploader removes the original when they delete the photo from the album.
      allow delete: if isOwner();
    }

    // Profile avatars (FEAT-015): a user writes only their own avatar. Reads are
    // owner-only for now; peers fetch the synced copy via the tokenized download
    // URL stored on the profile (cross-device avatar fetch lands in FEAT-015 PR 2).
    match /avatars/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
